module dev.avinlang.cairo

// A context draws on a surface: it holds a path, a source to paint it with, a line width and a
// transform from the user's coordinates to the surface's, and saves and restores them as a stack.
//
// A drawing call answers nothing. A failure, such as a matrix that cannot be inverted or a surface
// already finished, is kept on the context, which then ignores every later call; `status()` answers
// it, and `Surface.writeToPng` and `Surface.finish` answer what the surface holds.

// A drawing context, counted by Cairo. It holds a reference to its surface, so the surface lives
// while the context does, whatever becomes of the surface's own handle.
@c(type: "cairo_t *", release: "cairo_destroy", retain: "cairo_reference")
class Context
  @c("cairo_status_t cairo_status(cairo_t *self)")
  private statusRaw() -> Result[unit, int]

  // `Ok` while the context is usable, and the failure it holds otherwise.
  status() -> Result[unit, CairoError] = statusRaw().mapErr(cairoError)

  // How many references Cairo counts on the context.
  @c("unsigned int cairo_get_reference_count(cairo_t *self)")
  referenceCount() -> long

  // The surface the context draws on: a handle of its own on it.
  @c("cairo_surface_t *cairo_get_target(cairo_t *self)", borrowed)
  target() -> Surface

  // Pushes the context's state, its source, line width, transform and the rest, but not its path.
  @c("void cairo_save(cairo_t *self)")
  save()

  // Pops the state the matching `save` pushed. A `restore` with no `save` is a failure the context
  // keeps.
  @c("void cairo_restore(cairo_t *self)")
  restore()

  // Paints with an opaque colour from now on; each component from 0 to 1.
  @c("void cairo_set_source_rgb(cairo_t *self, double red, double green, double blue)")
  setSourceRgb(red: real, green: real, blue: real)

  // Paints with a colour and an alpha from now on; each from 0 to 1.
  @c("void cairo_set_source_rgba(cairo_t *self, double red, double green, double blue, double alpha)")
  setSourceRgba(red: real, green: real, blue: real, alpha: real)

  // Paints with `pattern` from now on, which the context holds a reference to.
  @c("void cairo_set_source(cairo_t *self, cairo_pattern_t *source)")
  setSource(pattern: Pattern)

  // Paints with `surface` from now on, its origin placed at (`x`, `y`) in user space; the context holds
  // a reference to it.
  @c("void cairo_set_source_surface(cairo_t *self, cairo_surface_t *surface, double x, double y)")
  setSourceSurface(surface: Surface, x: real, y: real)

  // The pattern the context paints with: a handle of its own on it.
  @c("cairo_pattern_t *cairo_get_source(cairo_t *self)", borrowed)
  source() -> Pattern

  // The width `stroke` draws lines with, in user units; 2 to begin with.
  @c("void cairo_set_line_width(cairo_t *self, double width)")
  setLineWidth(width: real)

  @c("double cairo_get_line_width(cairo_t *self)")
  lineWidth() -> real

  // Empties the path.
  @c("void cairo_new_path(cairo_t *self)")
  newPath()

  // Begins a new piece of the path at (`x`, `y`).
  @c("void cairo_move_to(cairo_t *self, double x, double y)")
  moveTo(x: real, y: real)

  // Adds a line from the current point to (`x`, `y`).
  @c("void cairo_line_to(cairo_t *self, double x, double y)")
  lineTo(x: real, y: real)

  // Adds a closed rectangle, its corner at (`x`, `y`).
  @c("void cairo_rectangle(cairo_t *self, double x, double y, double width, double height)")
  rectangle(x: real, y: real, width: real, height: real)

  // Adds an arc of the circle about (`xc`, `yc`) from `angle1` to `angle2`, in radians, turning
  // from the positive x axis towards the positive y axis; joined to the current point by a line.
  @c("void cairo_arc(cairo_t *self, double xc, double yc, double radius, double angle1, double angle2)")
  arc(xc: real, yc: real, radius: real, angle1: real, angle2: real)

  // Adds a line back to where the current piece of the path began, and joins the two ends.
  @c("void cairo_close_path(cairo_t *self)")
  closePath()

  // Adds a cubic Bezier curve from the current point, by two control points to an end point.
  @c("void cairo_curve_to(cairo_t *self, double x1, double y1, double x2, double y2, double x3, double y3)")
  curveTo(x1: real, y1: real, x2: real, y2: real, x3: real, y3: real)

  @c("cairo_path_t *cairo_copy_path(cairo_t *self)")
  private copyPathRaw() -> PathData

  @c("cairo_path_t *cairo_copy_path_flat(cairo_t *self)")
  private copyPathFlatRaw() -> PathData

  @c("cairo_rectangle_list_t *cairo_copy_clip_rectangle_list(cairo_t *self)")
  private copyClipRectangleListRaw() -> RectangleListData

  @c("void cairo_append_path(cairo_t *self, const cairo_path_t *path)")
  private appendPathRaw(path: PathData)

  // A copy of the current path. `Err` where the context has failed.
  copyPath() -> Result[Path, CairoError] = pathOf(copyPathRaw())

  // A copy of the current path with each curve replaced by lines, so it holds only `MoveTo`,
  // `LineTo` and `ClosePath`.
  copyPathFlat() -> Result[Path, CairoError] = pathOf(copyPathFlatRaw())

  // Adds a copied path to the current path.
  appendPath(path: Path) = appendPathRaw(path.raw())

  // The clip as rectangles, when it is one: `Err` with `ClipNotRepresentable` for a clip that is not
  // made of device-aligned rectangles, such as one under a rotation.
  copyClipRectangleList() -> Result[Vector[Rectangle], CairoError] = rectanglesOf(copyClipRectangleListRaw())

  // Whether the path has a current point: something was added since it was last emptied.
  @c("cairo_bool_t cairo_has_current_point(cairo_t *self)")
  hasCurrentPoint() -> bool

  // Whether (`x`, `y`) is inside the area `fill` would paint.
  @c("cairo_bool_t cairo_in_fill(cairo_t *self, double x, double y)")
  inFill(x: real, y: real) -> bool

  // Whether (`x`, `y`) is inside the area `stroke` would paint.
  @c("cairo_bool_t cairo_in_stroke(cairo_t *self, double x, double y)")
  inStroke(x: real, y: real) -> bool

  // Draws the path's lines with the source, at the line width, and empties the path.
  @c("void cairo_stroke(cairo_t *self)")
  stroke()

  // Draws the path's lines as `stroke` does, keeping the path.
  @c("void cairo_stroke_preserve(cairo_t *self)")
  strokePreserve()

  // Paints the inside of the path with the source, and empties the path.
  @c("void cairo_fill(cairo_t *self)")
  fill()

  // Paints the inside of the path as `fill` does, keeping the path.
  @c("void cairo_fill_preserve(cairo_t *self)")
  fillPreserve()

  // Paints the source over the whole surface.
  @c("void cairo_paint(cairo_t *self)")
  paint()

  // Moves the origin of the user's coordinates to (`tx`, `ty`).
  @c("void cairo_translate(cairo_t *self, double tx, double ty)")
  translate(tx: real, ty: real)

  // Stretches the user's coordinates by `sx` across and `sy` down. A factor of 0 leaves a transform
  // that cannot be inverted, a failure the context keeps.
  @c("void cairo_scale(cairo_t *self, double sx, double sy)")
  scale(sx: real, sy: real)

  // Turns the user's coordinates by `angle` radians, from the positive x axis towards the positive y.
  @c("void cairo_rotate(cairo_t *self, double angle)")
  rotate(angle: real)

  // Ends the page: a PDF surface begins its next, and an image surface keeps what was drawn.
  @c("void cairo_show_page(cairo_t *self)")
  showPage()

  // Begins a tag of a PDF document's structure, such as `H1`, `P` or `Document`, with its
  // attributes; the tags nest, each closed by `tagEnd` with its name.
  @c("void cairo_tag_begin(cairo_t *self, const char *tag_name, const char *attributes)")
  tagBegin(name: string, attributes: string = "")

  @c("void cairo_tag_end(cairo_t *self, const char *tag_name)")
  tagEnd(name: string)

  @c(
    "void cairo_select_font_face(cairo_t *self, const char *family, cairo_font_slant_t slant, cairo_font_weight_t weight)"
  )
  private selectFontFaceRaw(family: string, slant: FontSlant, weight: FontWeight)

  // Draws text from now on with the font of `family` the system finds, such as `serif` or
  // `Georgia`, in the slant and weight given.
  selectFontFace(family: string, slant: FontSlant = Upright, weight: FontWeight = Regular) =
    selectFontFaceRaw(family, slant, weight)

  // Draws text `size` user units high from now on.
  @c("void cairo_set_font_size(cairo_t *self, double size)")
  setFontSize(size: real)

  // Draws `text` from the current point along its baseline, moving the current point to its end.
  @c("void cairo_show_text(cairo_t *self, const char *utf8)")
  showText(text: string)

  @c("cairo_status_t cairo_status(cairo_t *self)")
  private statusMirror() -> Status

  // The context's status as Cairo numbers it: `Success` while it is usable.
  statusKind() -> Status = statusMirror()

  // How a source is composited from now on; `Over` to begin with.
  @c("void cairo_set_operator(cairo_t *self, cairo_operator_t op)")
  setOperator(op: Operator)

  @c("cairo_operator_t cairo_get_operator(cairo_t *self)")
  operator() -> Operator

  // How edges are smoothed from now on; `Default` to begin with.
  @c("void cairo_set_antialias(cairo_t *self, cairo_antialias_t antialias)")
  setAntialias(antialias: Antialias)

  @c("cairo_antialias_t cairo_get_antialias(cairo_t *self)")
  antialias() -> Antialias

  // Which parts of a self-crossing path `fill` paints; `Winding` to begin with.
  @c("void cairo_set_fill_rule(cairo_t *self, cairo_fill_rule_t fill_rule)")
  setFillRule(rule: FillRule)

  @c("cairo_fill_rule_t cairo_get_fill_rule(cairo_t *self)")
  fillRule() -> FillRule

  // How `stroke` ends a line; `Butt` to begin with.
  @c("void cairo_set_line_cap(cairo_t *self, cairo_line_cap_t line_cap)")
  setLineCap(cap: LineCap)

  @c("cairo_line_cap_t cairo_get_line_cap(cairo_t *self)")
  lineCap() -> LineCap

  // How `stroke` joins two lines; `Miter` to begin with.
  @c("void cairo_set_line_join(cairo_t *self, cairo_line_join_t line_join)")
  setLineJoin(join: LineJoin)

  @c("cairo_line_join_t cairo_get_line_join(cairo_t *self)")
  lineJoin() -> LineJoin

  @c("void cairo_get_current_point(cairo_t *self, out double *x, out double *y)")
  private currentPointRaw() -> (real, real)

  // The end of the path so far, in user coordinates; `None` while the path is empty.
  currentPoint() -> Option[(real, real)] = if hasCurrentPoint() then Some(currentPointRaw()) else None

  // The device coordinates of the user's point (`x`, `y`).
  @c("void cairo_user_to_device(cairo_t *self, inout double *x, inout double *y)")
  userToDevice(x: real, y: real) -> (real, real)

  // The user coordinates of the device's point (`x`, `y`). A transform that cannot be inverted is a
  // failure the context keeps.
  @c("void cairo_device_to_user(cairo_t *self, inout double *x, inout double *y)")
  deviceToUser(x: real, y: real) -> (real, real)

  // The device's distance vector for the user's (`dx`, `dy`): the transform without its translation.
  @c("void cairo_user_to_device_distance(cairo_t *self, inout double *dx, inout double *dy)")
  userToDeviceDistance(dx: real, dy: real) -> (real, real)

  // The user's distance vector for the device's (`dx`, `dy`).
  @c("void cairo_device_to_user_distance(cairo_t *self, inout double *dx, inout double *dy)")
  deviceToUserDistance(dx: real, dy: real) -> (real, real)

  // The box `fill` would paint in, as (left, top, right, bottom) in user units.
  @c("void cairo_fill_extents(cairo_t *self, out double *x1, out double *y1, out double *x2, out double *y2)")
  fillExtents() -> (real, real, real, real)

  // The box `stroke` would paint in, as (left, top, right, bottom) in user units.
  @c("void cairo_stroke_extents(cairo_t *self, out double *x1, out double *y1, out double *x2, out double *y2)")
  strokeExtents() -> (real, real, real, real)

  // The box around the path's points, as (left, top, right, bottom) in user units.
  @c("void cairo_path_extents(cairo_t *self, out double *x1, out double *y1, out double *x2, out double *y2)")
  pathExtents() -> (real, real, real, real)

  // The box `paint` is limited to, as (left, top, right, bottom) in user units: huge while there is
  // no clip.
  @c("void cairo_clip_extents(cairo_t *self, out double *x1, out double *y1, out double *x2, out double *y2)")
  clipExtents() -> (real, real, real, real)

  // Whether (`x`, `y`) is inside the clip.
  @c("cairo_bool_t cairo_in_clip(cairo_t *self, double x, double y)")
  inClip(x: real, y: real) -> bool

  // Intersects the clip with the path, and empties the path.
  @c("void cairo_clip(cairo_t *self)")
  clip()

  // Intersects the clip with the path, keeping the path.
  @c("void cairo_clip_preserve(cairo_t *self)")
  clipPreserve()

  // Removes the clip.
  @c("void cairo_reset_clip(cairo_t *self)")
  resetClip()

  // Strokes with a dash pattern: alternating lengths of line and gap, in user units, repeated, the
  // first `offset` into it. An empty pattern is a solid line. A negative length, or lengths all of 0,
  // is a failure the context keeps.
  @c("void cairo_set_dash(cairo_t *self, const double *dashes, length(dashes) int num_dashes, double offset)")
  setDash(dashes: Array[real], offset: real = 0.0)

  // How many lengths the dash pattern has; 0 for a solid line.
  @c("int cairo_get_dash_count(cairo_t *self)")
  dashCount() -> int

  // The dash pattern and its offset, as `setDash` set them; an empty pattern for a solid line.
  @c("void cairo_get_dash(cairo_t *self, out double *dashes, out double *offset)", array: "dashes", length: "cairo_get_dash_count(self)")
  dash() -> (Array[real], real)

  // The transform from user coordinates to the surface's.
  @c("void cairo_get_matrix(cairo_t *self, out cairo_matrix_t *matrix)")
  matrix() -> Matrix

  // Replaces the transform from user coordinates to the surface's. A matrix that cannot be inverted
  // is a failure the context keeps.
  @c("void cairo_set_matrix(cairo_t *self, const cairo_matrix_t *matrix)")
  setMatrix(matrix: Matrix)

  // Applies `matrix` to the user's coordinates, before the transform already there.
  @c("void cairo_transform(cairo_t *self, const cairo_matrix_t *matrix)")
  transform(matrix: Matrix)

  // Sets the transform to the identity: the user's coordinates are the surface's.
  @c("void cairo_identity_matrix(cairo_t *self)")
  identityMatrix()

  // What `text` would measure if shown with the current font, in user units.
  @c("void cairo_text_extents(cairo_t *self, const char *utf8, out cairo_text_extents_t *extents)")
  textExtents(text: string) -> TextExtents

  // What the current font measures, in user units.
  @c("void cairo_font_extents(cairo_t *self, out cairo_font_extents_t *extents)")
  fontExtents() -> FontExtents

  // What the glyphs would measure together if shown with the current font.
  @c(
    "void cairo_glyph_extents(cairo_t *self, const cairo_glyph_t *glyphs, length(glyphs) int num_glyphs, out cairo_text_extents_t *extents)"
  )
  glyphExtents(glyphs: Array[Glyph]) -> TextExtents

  // Draws the glyphs with the current font and source.
  @c("void cairo_show_glyphs(cairo_t *self, const cairo_glyph_t *glyphs, length(glyphs) int num_glyphs)")
  showGlyphs(glyphs: Array[Glyph])

  // Adds the outlines of the glyphs to the path.
  @c("void cairo_glyph_path(cairo_t *self, const cairo_glyph_t *glyphs, length(glyphs) int num_glyphs)")
  glyphPath(glyphs: Array[Glyph])

  // The face drawing text from now on: a handle of its own on it.
  @c("cairo_font_face_t *cairo_get_font_face(cairo_t *self)", borrowed)
  fontFace() -> FontFace

  // Draws text with `face` from now on.
  @c("void cairo_set_font_face(cairo_t *self, cairo_font_face_t *font_face)")
  setFontFace(face: FontFace)

  // Draws text with the options from now on.
  @c("void cairo_set_font_options(cairo_t *self, const cairo_font_options_t *options)")
  setFontOptions(options: FontOptions)

  // The font drawing text now: a handle of its own on it.
  @c("cairo_scaled_font_t *cairo_get_scaled_font(cairo_t *self)", borrowed)
  scaledFont() -> ScaledFont
