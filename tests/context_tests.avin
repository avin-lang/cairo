module tests

// Contexts: their state and its stack, every path and drawing call, the transforms, text, the
// failures a context keeps, and the surface a context keeps alive.
import avin.fs
import avin.math.Pi
import dev.avinlang.cairo.{Argb32, Bold, Context, Italic, Oblique, Regular, Upright, imageSurface, linearGradient, solidRgb}

@test("a new context paints black with lines 2 wide, has no path and is usable")
defaults()
    val cr = canvas(10, 10)
    assertEq(cr.lineWidth(), 2.0)
    assert(!cr.hasCurrentPoint())
    assertEq(code(cr.status()), 0)
    assertEq(cr.referenceCount(), 1)

@test("setLineWidth is read back, 0 included, and a negative width is taken as 0")
lineWidths()
    val cr = canvas(10, 10)
    cr.setLineWidth(0.5)
    assertEq(cr.lineWidth(), 0.5)
    cr.setLineWidth(0)
    assertEq(cr.lineWidth(), 0.0)
    cr.setLineWidth(1e9)
    assertEq(cr.lineWidth(), 1e9)
    cr.setLineWidth(-3)
    assertEq(cr.lineWidth(), 0.0)
    assertEq(code(cr.status()), 0)

@test("save pushes the state and restore pops it, nested, and the path is not part of it")
saveRestore()
    val cr = canvas(10, 10)
    cr.setLineWidth(5)
    cr.save()
    cr.setLineWidth(6)
    cr.save()
    cr.setLineWidth(7)
    cr.moveTo(1, 1)
    cr.restore()
    assertEq(cr.lineWidth(), 6.0)
    assert(cr.hasCurrentPoint())
    cr.restore()
    assertEq(cr.lineWidth(), 5.0)
    assertEq(code(cr.status()), 0)

@test("restore with no save is a failure the context keeps, and it then ignores what it is told")
restoreWithoutSave()
    val cr = canvas(10, 10)
    cr.restore()
    val e = failure(cr.status())
    assertEq(e.code, 2)
    assertEq(e.message, "cairo_restore() without matching cairo_save()")
    cr.moveTo(1, 1)
    assert(!cr.hasCurrentPoint())
    cr.save()
    cr.restore()
    assertEq(code(cr.status()), 2)

@test("moveTo, lineTo, rectangle and arc give the path a current point, and newPath empties it")
paths()
    val cr = canvas(10, 10)
    cr.moveTo(1, 1)
    assert(cr.hasCurrentPoint())
    cr.lineTo(5, 5)
    cr.newPath()
    assert(!cr.hasCurrentPoint())
    cr.rectangle(1, 1, 2, 2)
    assert(cr.hasCurrentPoint())
    cr.newPath()
    cr.arc(5, 5, 2, 0, Pi)
    assert(cr.hasCurrentPoint())
    cr.closePath()
    assert(cr.hasCurrentPoint())
    assertEq(code(cr.status()), 0)

@test("lineTo with no current point begins the path there, as moveTo would")
lineToFirst()
    val cr = canvas(10, 10)
    cr.lineTo(3, 3)
    assert(cr.hasCurrentPoint())
    assertEq(code(cr.status()), 0)

@test("stroke and fill empty the path, their _preserve forms keep it, and paint leaves it alone")
consumingThePath()
    val cr = canvas(20, 20)
    cr.rectangle(2, 2, 5, 5)
    cr.strokePreserve()
    assert(cr.hasCurrentPoint())
    cr.stroke()
    assert(!cr.hasCurrentPoint())
    cr.rectangle(2, 2, 5, 5)
    cr.fillPreserve()
    assert(cr.hasCurrentPoint())
    cr.paint()
    assert(cr.hasCurrentPoint())
    cr.fill()
    assert(!cr.hasCurrentPoint())
    cr.stroke()
    cr.fill()
    assertEq(code(cr.status()), 0)

@test("inFill and inStroke answer for a rectangle, a circle and a closed triangle")
hitTests()
    val cr = canvas(100, 100)
    cr.rectangle(10, 10, 20, 20)
    assert(cr.inFill(15, 15))
    assert(!cr.inFill(5, 5))
    assert(!cr.inFill(31, 15))
    assert(cr.inStroke(10, 20))
    assert(!cr.inStroke(20, 20))
    cr.newPath()
    cr.arc(50, 50, 10, 0, 2 * Pi)
    assert(cr.inFill(50, 50))
    assert(cr.inFill(59, 50))
    assert(!cr.inFill(61, 50))
    assert(!cr.inFill(58, 58))
    cr.newPath()
    cr.moveTo(0, 0)
    cr.lineTo(40, 0)
    cr.lineTo(0, 40)
    cr.closePath()
    assert(cr.inFill(5, 5))
    assert(!cr.inFill(30, 30))
    cr.setLineWidth(4)
    assert(cr.inStroke(20, 20))
    assert(!cr.inStroke(10, 10))

@test("an empty path holds no point, and a path of one point no area")
emptyHitTests()
    val cr = canvas(10, 10)
    assert(!cr.inFill(0, 0))
    assert(!cr.inStroke(0, 0))
    cr.moveTo(5, 5)
    assert(!cr.inFill(5, 5))

@test("translate moves the user's origin: a path drawn before is found at the new coordinates")
translation()
    val cr = canvas(200, 100)
    cr.rectangle(0, 0, 10, 10)
    cr.translate(100, 0)
    assert(!cr.inFill(5, 5))
    assert(cr.inFill(-95, 5))
    cr.translate(-100, 0)
    assert(cr.inFill(5, 5))

@test("scale stretches the user's coordinates, by a different factor on each axis and by a negative one")
scaling()
    val cr = canvas(100, 100)
    cr.rectangle(0, 0, 10, 10)
    cr.scale(2, 2)
    assert(cr.inFill(4, 4))
    assert(!cr.inFill(6, 6))
    cr.scale(1, 0.25)
    assert(cr.inFill(4, 16))
    assert(!cr.inFill(4, 24))
    cr.scale(-1, 1)
    assert(cr.inFill(-4, 16))
    assert(!cr.inFill(4, 16))

@test("rotate turns the user's coordinates from the x axis towards the y axis")
rotation()
    val cr = canvas(100, 100)
    cr.rectangle(0, 0, 10, 10)
    cr.rotate(Pi / 2)
    assert(cr.inFill(5, -5))
    assert(!cr.inFill(5, 5))
    cr.rotate(-Pi / 2)
    assert(cr.inFill(5, 5))
    cr.rotate(2 * Pi)
    assert(cr.inFill(5, 5))

@test("transforms are part of the saved state")
transformsSaved()
    val cr = canvas(100, 100)
    cr.rectangle(0, 0, 10, 10)
    cr.save()
    cr.translate(50, 50)
    cr.scale(3, 3)
    cr.rotate(1)
    cr.restore()
    assert(cr.inFill(5, 5))

@test("a scale of 0 leaves a transform with no inverse, a failure the context keeps")
singularScale()
    val cr = canvas(10, 10)
    cr.scale(0, 1)
    val e = failure(cr.status())
    assertEq(e.code, 5)
    assertEq(e.message, "invalid matrix (not invertible)")

// Cairo lends a failed context's caller a surface in error rather than the one it drew on.
@test("a failed context lends a surface in error, and its own surface is unharmed and still written")
failedContextSurface()
    val s = made(imageSurface(Argb32, 10, 10))
    val cr = made(s.context())
    cr.restore()
    val t = cr.target()
    assertEq(code(t.status()), 1)
    assertEq(failure(t.writeToPng(s"${scratch()}/lent.png")).code, 1)
    t.close()
    assertEq(code(s.status()), 0)
    val path = s"${scratch()}/after-failure.png"
    made(s.writeToPng(path))
    assertEq(pngHeader(path), "10x10 depth 8 colour 6")

// Cairo writes an ARGB32 surface every pixel of which is opaque as a PNG of colour alone (type 2),
// and one with any transparency with alpha (type 6): the header tells whether a paint covered it.
@test("painting covers the surface with opaque pixels, and a fill of part of it leaves the rest transparent")
coverage()
    val dir = scratch()
    val blank = canvas(8, 8)
    made(blank.target().writeToPng(s"$dir/blank.png"))
    assertEq(pngHeader(s"$dir/blank.png"), "8x8 depth 8 colour 6")
    val painted = canvas(8, 8)
    painted.paint()
    made(painted.target().writeToPng(s"$dir/painted.png"))
    assertEq(pngHeader(s"$dir/painted.png"), "8x8 depth 8 colour 2")
    val part = canvas(8, 8)
    part.rectangle(0, 0, 4, 8)
    part.fill()
    made(part.target().writeToPng(s"$dir/part.png"))
    assertEq(pngHeader(s"$dir/part.png"), "8x8 depth 8 colour 6")
    val translucent = canvas(8, 8)
    translucent.setSourceRgba(1, 0, 0, 0.5)
    translucent.paint()
    made(translucent.target().writeToPng(s"$dir/translucent.png"))
    assertEq(pngHeader(s"$dir/translucent.png"), "8x8 depth 8 colour 6")
    val covered = canvas(8, 8)
    covered.translate(4, 0)
    covered.rectangle(-4, 0, 8, 8)
    covered.fill()
    made(covered.target().writeToPng(s"$dir/covered.png"))
    assertEq(pngHeader(s"$dir/covered.png"), "8x8 depth 8 colour 2")

@test("the default source is a solid pattern of the context's, lent as a handle of its own")
defaultSource()
    val cr = canvas(10, 10)
    val p = cr.source()
    assertEq(code(p.status()), 0)
    assert(p.referenceCount() >= 2)
    p.close()

@test("setSourceRgb and setSourceRgba replace the source, each component at its limits")
colours()
    val cr = canvas(10, 10)
    cr.setSourceRgb(0, 0, 0)
    cr.setSourceRgb(1, 1, 1)
    cr.setSourceRgba(0, 0, 0, 0)
    cr.setSourceRgba(1, 1, 1, 1)
    cr.setSourceRgba(2, -1, 0.5, 7)
    cr.paint()
    assertEq(code(cr.status()), 0)

@test("setSource paints with a pattern, which the context references and source() lends back")
patternSource()
    val cr = canvas(10, 10)
    val g = made(linearGradient(0, 0, 10, 0))
    assertEq(g.referenceCount(), 1)
    cr.setSource(g)
    assertEq(g.referenceCount(), 2)
    val back = cr.source()
    assertEq(back.referenceCount(), 3)
    assert(!(back == g))
    back.close()
    cr.setSourceRgb(0, 0, 0)
    assertEq(g.referenceCount(), 1)

@test("save and restore bring back the source, with the reference the saved state holds")
sourceSaved()
    val cr = canvas(10, 10)
    val g = made(solidRgb(1, 0, 0))
    cr.setSource(g)
    cr.save()
    cr.setSourceRgb(0, 1, 0)
    assertEq(g.referenceCount(), 2)
    cr.restore()
    assertEq(g.referenceCount(), 2)
    cr.close()
    assertEq(g.referenceCount(), 1)

@test("text is drawn with the toy font calls, in every slant and weight, moving the current point")
text()
    val cr = canvas(200, 50)
    for slant in [Upright, Italic, Oblique]
        for weight in [Regular, Bold]
            cr.selectFontFace("serif", slant, weight)
    cr.selectFontFace("sans-serif")
    cr.setFontSize(12)
    cr.moveTo(5, 30)
    cr.showText("été \u{1F600} 日本")
    assert(cr.hasCurrentPoint())
    cr.showText("")
    cr.selectFontFace("")
    cr.showText("x")
    assertEq(code(cr.status()), 0)

@test(should_trap: "holds a NUL")
textWithNul()
    val cr = canvas(10, 10)
    cr.showText("a\u{0}b")

@test("tags and showPage on an image surface are accepted and change nothing")
imageTags()
    val cr = canvas(10, 10)
    cr.tagBegin("P")
    cr.tagEnd("P")
    cr.showPage()
    assertEq(code(cr.status()), 0)

@test(should_trap: "`Context` is closed")
closedStroke()
    val cr = canvas(10, 10)
    cr.close()
    cr.stroke()

@test(should_trap: "`Context` is closed")
closedStatus()
    val cr = canvas(10, 10)
    cr.close()
    cr.status()

@test(should_trap: "`Pattern` is closed")
closedSource()
    val cr = canvas(10, 10)
    val g = made(linearGradient(0, 0, 1, 1))
    g.close()
    cr.setSource(g)

@test("closing the context twice gives its reference back once")
contextCloseTwice()
    val s = made(imageSurface(Argb32, 2, 2))
    val cr = made(s.context())
    cr.close()
    cr.close()
    assertEq(s.referenceCount(), 1)

@test("a context on a finished surface is made, and drawing on it is the surface's failure")
finishedSurface()
    val s = made(imageSurface(Argb32, 4, 4))
    made(s.finish())
    s.context() match
        Ok(cr) ->
            cr.paint()
            assertEq(code(cr.status()), 12)
        Err(e) -> assertEq(e.code, 12)

// A context whose surface's handle went out of reach as soon as it was made.
private orphan(width: int, height: int) -> Context = made(made(imageSurface(Argb32, width, height)).context())

// Enough allocation for the collector to run, under stress or not.
private churn() -> int =
    var total = 0
    for i in 0..<2000
        total += [i, i + 1, i + 2].length()
    total

@test("a context keeps its surface after the surface's handle is closed, and draws into it")
keepsClosedSurface()
    val s = made(imageSurface(Argb32, 30, 20))
    val cr = made(s.context())
    s.close()
    churn()
    cr.setSourceRgb(1, 0, 0)
    cr.paint()
    val path = s"${scratch()}/kept.png"
    made(cr.target().writeToPng(path))
    assertEq(pngHeader(path), "30x20 depth 8 colour 2")

@test("a context keeps its surface after the surface's handle is collected, and draws into it")
keepsCollectedSurface()
    val cr = orphan(25, 15)
    churn()
    cr.rectangle(0, 0, 10, 10)
    cr.fill()
    assertEq(code(cr.status()), 0)
    val t = cr.target()
    assertEq(t.width(), 25)
    val path = s"${scratch()}/orphan.png"
    made(t.writeToPng(path))
    assertEq(pngHeader(path), "25x15 depth 8 colour 6")

@test("a thousand contexts and surfaces made and dropped are given back by their finalizers")
manyDropped()
    for i in 0..<1000
        val cr = orphan(1 + i % 7, 1 + i % 5)
        cr.paint()
        assertEq(code(cr.status()), 0)
    assertEq(churn(), 6000)

@test("a lent target outlives the context it came from")
targetOutlivesContext()
    val cr = canvas(6, 6)
    val t = cr.target()
    cr.close()
    churn()
    val path = s"${scratch()}/target.png"
    made(t.writeToPng(path))
    assertEq(pngHeader(path), "6x6 depth 8 colour 6")
