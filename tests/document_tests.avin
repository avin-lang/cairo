module tests

// PDF and SVG surfaces: made, drawn on, given metadata, outlines, page labels and tags, finished, and
// their files read back. A PDF restricted to version 1.4 writes its objects uncompressed, so its
// metadata, outline and structure can be found in its bytes.
import avin.fs

import dev.avinlang.cairo.{
  Argb32,
  Author,
  CreateDate,
  Creator,
  Keywords,
  ModDate,
  OutlineFlags,
  Subject,
  Surface,
  Title,
  V14,
  V15,
  V16,
  V17,
  imageSurface,
  outlineRoot,
  pdfSurface,
  svgSurface
}

// How many times `part` occurs in `text`.
occurrences(text: string, part: string) -> int = text.split(part).length() - 1

@test("each PDF version is named as its header writes it, and a restricted document's header says it")
pdfVersions()
  val dir = scratch()
  for (v, name) in [(V14, "1.4"), (V15, "1.5"), (V16, "1.6"), (V17, "1.7")]
    assertEq(v.text(), s"PDF $name")
    val path = s"$dir/$v.pdf"
    val pdf = made(pdfSurface(path, 100, 100))
    pdf.restrictToVersion(v)
    made(pdf.finish())
    assert(textOf(path).startsWith(s"%PDF-$name\n"))

@test("a PDF surface writes its file at once, and completes the document when finished")
pdfFinish()
  val path = s"${scratch()}/finish.pdf"
  val pdf = made(pdfSurface(path, 200, 100))
  assert(fs.exists(path))
  val cr = made(pdf.context())
  cr.rectangle(10, 10, 50, 50)
  cr.fill()
  made(pdf.finish())
  val text = textOf(path)
  assert(text.startsWith("%PDF-"))
  assert(text.endsWith("%%EOF\n"))
  made(pdf.finish())

@test("a PDF surface on a file that cannot be written is Err, a write error")
pdfMissingDirectory()
  val dir = scratch()
  val e = failure(pdfSurface(s"$dir/missing/out.pdf", 100, 100))
  assertEq(e.code, 11)
  assertEq(e.message, "error while writing to output stream")

@test("a PDF surface of no size and one of a negative size are made: Cairo leaves the page size to the caller")
pdfSizes()
  val dir = scratch()
  made(made(pdfSurface(s"$dir/zero.pdf", 0, 0)).finish())
  made(made(pdfSurface(s"$dir/negative.pdf", -5, 100)).finish())

@test("drawing on a finished PDF surface is the context's failure, and the document is left as it was")
drawAfterFinish()
  val path = s"${scratch()}/done.pdf"
  val pdf = made(pdfSurface(path, 100, 100))
  val cr = made(pdf.context())
  made(pdf.finish())
  val before = bytesOf(path).length()
  cr.paint()
  val e = failure(cr.status())
  assertEq(e.code, 12)
  assertEq(e.message, "the target surface has been finished")
  assertEq(bytesOf(path).length(), before)

@test("a PDF surface reads as no image: no size, no format, and its status unharmed")
pdfIsNoImage()
  val pdf = made(pdfSurface(s"${scratch()}/plain.pdf", 100, 100))
  assertEq(pdf.width(), 0)
  assertEq(pdf.height(), 0)
  assertEq(pdf.stride(), 0)
  assertEq(pdf.format(), None)
  assertEq(code(pdf.status()), 0)

@test("a PDF surface's pages are drawn into an image for writeToPng")
pdfToPng()
  val dir = scratch()
  val pdf = made(pdfSurface(s"$dir/page.pdf", 30, 20))
  val cr = made(pdf.context())
  cr.paint()
  made(pdf.writeToPng(s"$dir/page.png"))
  assert(isPng(bytesOf(s"$dir/page.png")))

@test("a PDF call on an image surface is a failure the surface keeps")
pdfCallOnImage()
  val calls: Vector[(Surface) -> unit] = [
    s -> s.setPageLabel("x"),
    s -> s.setMetadata(Title, "x"),
    s -> s.setCustomMetadata("a", "b"),
    s -> s.restrictToVersion(V15),
    s -> s.setSize(1, 1),
    s -> s.setThumbnailSize(1, 1)
  ]
  for call in calls
    val img = made(imageSurface(Argb32, 2, 2))
    call(img)
    val e = failure(img.status())
    assertEq(e.code, 13)
    assertEq(e.message, "the surface type is not appropriate for the operation")
    assertEq(failure(img.writeToPng(s"${scratch()}/mismatch.png")).code, 13)

@test("every metadata entry is written into the document's information")
metadata()
  val path = s"${scratch()}/metadata.pdf"
  val pdf = made(pdfSurface(path, 100, 100))
  pdf.restrictToVersion(V14)
  pdf.setMetadata(Title, "A title")
  pdf.setMetadata(Author, "An author")
  pdf.setMetadata(Subject, "A subject")
  pdf.setMetadata(Keywords, "one, two")
  pdf.setMetadata(Creator, "A creator")
  pdf.setMetadata(CreateDate, "2026-06-12T00:00:00Z")
  pdf.setMetadata(ModDate, "2026-06-13T01:02:03Z")
  pdf.setCustomMetadata("Notes", "custom value")
  made(pdf.finish())
  val text = textOf(path)
  for part in [
    "/Title (A title)",
    "/Author (An author)",
    "/Subject (A subject)",
    "/Keywords (one, two)",
    "/Creator (A creator)",
    "/CreationDate (20260612000000Z)",
    "/ModDate (20260613010203Z)",
    "/Notes (custom value)"
  ]
    assert(text.contains(part), part)

@test("text outside ASCII is written as UTF-16, and an empty custom value removes the entry")
metadataText()
  val path = s"${scratch()}/unicode.pdf"
  val pdf = made(pdfSurface(path, 100, 100))
  pdf.restrictToVersion(V14)
  pdf.setMetadata(Author, "Ed é")
  pdf.setCustomMetadata("Gone", "here")
  pdf.setCustomMetadata("Gone", "")
  made(pdf.finish())
  val text = textOf(path)
  assert(text.contains("/Author <FEFF00450064002000E9>"))
  assert(!text.contains("/Gone"))

@test("outline items are numbered from 1 in the order they are added, nested under their parents")
outline()
  val path = s"${scratch()}/outline.pdf"
  val pdf = made(pdfSurface(path, 100, 100))
  pdf.restrictToVersion(V14)
  val cr = made(pdf.context())
  cr.paint()
  cr.showPage()
  cr.paint()
  val top = pdf.addOutline(outlineRoot, "Top", "page=1", OutlineFlags(open = true, bold = true))
  assertEq(top, 1)
  assertEq(pdf.addOutline(top, "Under", "page=2 pos=[10 10]"), 2)
  assertEq(pdf.addOutline(outlineRoot, "Second été", "page=2", OutlineFlags(italic = true)), 3)
  cr.close()
  made(pdf.finish())
  val text = textOf(path)
  assert(text.contains("/Outlines"))
  assert(text.contains("/Title (Top)"))
  assert(text.contains("/Title (Under)"))

@test("an outline item under a parent that does not exist is not added: its id is 0, and the document is unharmed")
outlineBadParent()
  val pdf = made(pdfSurface(s"${scratch()}/bad-outline.pdf", 100, 100))
  assertEq(pdf.addOutline(42, "Orphan", "page=1"), 0)
  assertEq(pdf.addOutline(outlineRoot, "Real", "page=1"), 1)
  made(pdf.finish())

@test("page labels, tags, sizes and thumbnails make a tagged document of several pages")
pagesAndTags()
  val path = s"${scratch()}/pages.pdf"
  val pdf = made(pdfSurface(path, 200, 100))
  pdf.restrictToVersion(V14)
  pdf.setThumbnailSize(16, 8)
  val cr = made(pdf.context())
  cr.tagBegin("Document")
  pdf.setPageLabel("Cover")
  cr.tagBegin("H1")
  cr.moveTo(10, 50)
  cr.showText("Heading")
  cr.tagEnd("H1")
  cr.showPage()
  pdf.setSize(300, 300)
  pdf.setPageLabel("ii")
  cr.tagBegin("P")
  cr.moveTo(10, 50)
  cr.showText("Body")
  cr.tagEnd("P")
  cr.tagEnd("Document")
  pdf.showPage()
  assertEq(code(cr.status()), 0)
  cr.close()
  made(pdf.finish())
  val text = textOf(path)
  assertEq(occurrences(text, "/Type /Page\n") + occurrences(text, "/Type /Page "), 2)
  for part in [
    "/StructTreeRoot",
    "/MarkInfo",
    "/S /Document",
    "/S /H1",
    "/S /P",
    "/PageLabels",
    "/P (Cover)",
    "/P (ii)",
    "/MediaBox [ 0 0 300 300 ]"
  ]
    assert(text.contains(part), part)

@test("a tag ended that was never begun is found when the page ends, a failure the context and surface keep")
unbalancedTag()
  val pdf = made(pdfSurface(s"${scratch()}/tags.pdf", 100, 100))
  val cr = made(pdf.context())
  cr.tagEnd("P")
  assertEq(code(cr.status()), 0)
  cr.showPage()
  val e = failure(cr.status())
  assertEq(e.code, 42)
  assertEq(e.message, "invalid tag name, attributes, or nesting")
  assertEq(code(pdf.finish()), 42)

@test("an SVG surface writes an SVG document of its size, completed when finished")
svg()
  val path = s"${scratch()}/drawing.svg"
  val svg = made(svgSurface(path, 200, 100))
  val cr = made(svg.context())
  cr.setSourceRgb(1, 0, 0)
  cr.rectangle(10, 10, 50, 30)
  cr.fill()
  cr.close()
  made(svg.finish())
  val text = textOf(path)
  assert(text.startsWith("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg "))
  assert(text.contains("width=\"200\" height=\"100\" viewBox=\"0 0 200 100\""))
  assert(text.contains("rgb(100%, 0%, 0%)"))
  assert(text.endsWith("</svg>\n"))

@test("an SVG surface on a file that cannot be written is Err, a write error")
svgMissingDirectory()
  assertEq(failure(svgSurface(s"${scratch()}/missing/out.svg", 10, 10)).code, 11)

@test(should_trap: "`Surface` is closed")
closedPdf()
  val pdf = made(pdfSurface(s"${scratch()}/closed.pdf", 10, 10))
  pdf.close()
  pdf.setPageLabel("x")

@test(should_trap: "holds a NUL")
metadataWithNul()
  val pdf = made(pdfSurface(s"${scratch()}/nul.pdf", 10, 10))
  pdf.setMetadata(Title, "a\u{0}")
